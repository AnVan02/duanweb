                        </div>
                        <p class="news-date">Cập nhật ngày 07/07/2025</p>
                    </div>
                </div>
                
                <div class="news-card">
                    <a href="#">
                        <img src="https://via.placeholder.com/120x120/28a745/ffffff?text=Tech" alt="Tech News">
                    </a>
                    <div class="news-content">
                        <div class="news-title">
